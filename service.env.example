# Copy to ~/.config/x-bookmark-exporter/service.env and chmod 600 that file.
# Use an absolute vault path. Notes will be written under its X/ subdirectory.
X_BOOKMARK_VAULT="/absolute/path/to/your/vault"
# Optional: media folder relative to vault root (default: X/assets).
# X_BOOKMARK_ASSETS_FOLDER="Attachments/X"
# Only required for confidential OAuth clients:
# X_CLIENT_SECRET="replace-with-your-own-client-secret"
