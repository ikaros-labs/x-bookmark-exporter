# Copy to ~/.config/x2vault/service.env and chmod 600 that file.
# Use an absolute vault path. Notes will be written under its X/ subdirectory.
X2VAULT_VAULT="/absolute/path/to/your/vault"
# Optional: media folder relative to vault root (default: X/assets).
# X2VAULT_ASSETS_FOLDER="Attachments/X"
# Only required for confidential OAuth clients:
# X2VAULT_X_CLIENT_SECRET="replace-with-your-own-client-secret"
